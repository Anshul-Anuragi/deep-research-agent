# ==============================================================================
# Deep Research Agent - Environment Configuration
# Copy this file to .env and insert your API keys:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# API Keys (Provide at least ONE LLM provider + Tavily Search)
# ------------------------------------------------------------------------------

# Option A: OpenRouter (Recommended for free 1M-token Nemotron or DeepSeek models)
# Get your key at: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Option B: Google Gemini API (Alternative provider)
# Get your key at: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# Tavily Web Search API (Required for web retrieval)
# Get your key at: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here


# ------------------------------------------------------------------------------
# Model Selection
# ------------------------------------------------------------------------------
# Top recommended models:
# OpenRouter (Free, 1M context tokens):
#   - nvidia/nemotron-3-ultra-550b-a55b:free   (Flagship 550B, high reasoning quality)
#   - nvidia/nemotron-3.5-lightning:free       (Fast inference with tool support)
# OpenRouter (Paid):
#   - deepseek/deepseek-v4.1-flash-1017
#   - deepseek/deepseek-chat
# Google Gemini:
#   - gemini-3.5-flash
#   - gemini-3.5-flash-lite
DR_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free


# ------------------------------------------------------------------------------
# Research Engine Parameters
# ------------------------------------------------------------------------------
# Number of parallel subtopic research agents (default: 3)
DR_MAX_RESEARCHERS=3

# Maximum search steps (tool-call loops) per researcher (default: 6)
DR_MAX_STEPS=6

# Concurrency limit for simultaneous LLM calls (default: 3)
DR_CONCURRENCY=3
